{
  "name": "Tienda Online - ClaudioHub",
  "dataColors": ["#1F4E79", "#E07A5F", "#3D9970", "#F2B134", "#8E7CC3", "#5DADE2", "#7F8C8D", "#C0392B"],
  "background": "#FFFFFF",
  "foreground": "#1D2433",
  "tableAccent": "#1F4E79",
  "good": "#1E8E3E",
  "neutral": "#F2B134",
  "bad": "#D93025",
  "maximum": "#1F4E79",
  "center": "#9DB8D3",
  "minimum": "#EAF1F8",
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "fontFamily": "Segoe UI Semibold", "fontSize": 12, "fontColor": { "solid": { "color": "#1D2433" } } }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E6EC" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F6F8" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "fontSize": 24, "color": { "solid": { "color": "#1F4E79" } } }],
        "categoryLabels": [{ "fontSize": 10, "color": { "solid": { "color": "#5B6475" } } }]
      }
    }
  }
}
