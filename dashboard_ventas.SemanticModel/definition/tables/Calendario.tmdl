		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2024, 1, 1 ), MAX ( Ventas[Fecha] ) ),
				    "Año", YEAR ( [Date] ),
				    "Mes Num", MONTH ( [Date] ),
				    "Mes", FORMAT ( [Date], "mmm" ),
				    "Año-Mes", FORMAT ( [Date], "yyyy-mm" ),
				    "Trimestre", "T" & QUARTER ( [Date] ),
				    "Día Semana", FORMAT ( [Date], "dddd" ),
				    "Día Semana Num", WEEKDAY ( [Date], 2 )
				)

	annotation PBI_Id = 14618e8f9cbd4e0cb7b4d2aa766ec294

